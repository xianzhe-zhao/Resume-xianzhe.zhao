# 零依赖
node_modules/

# 环境与密钥
.env
.env.*

# 临时文件（含远程运维脚本，可能含敏感值，绝不入库）
.tmp/

# 日志
*.log

# 数据原写入临时文件
data/*.tmp

# 系统文件
.DS_Store
Thumbs.db

# 上传工具（一次性，不入库）
push-via-api.js

# 大文件预览图（防火墙按大小拦截，不入库）
preview.png

# 运行时解包产物（服务器启动时由 .gz 自动生成）
public/gsap.min.js
public/ScrollTrigger.min.js

# Python 缓存
__pycache__/
